# Configuración común para editores (emacs, VS Code). El formato de Rust lo decide rustfmt.
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json,html,css,js,ts}]
indent_size = 2

[*.md]
# Dos espacios al final de una línea son un salto de línea en Markdown.
trim_trailing_whitespace = false
